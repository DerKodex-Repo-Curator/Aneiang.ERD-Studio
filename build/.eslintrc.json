{
  "root": true,
  "env": { "browser": true, "es2022": true, "node": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "script" },
  "globals": {
    "window": "readonly", "document": "readonly", "navigator": "readonly",
    "console": "readonly", "localStorage": "readonly", "history": "readonly",
    "requestAnimationFrame": "readonly", "Image": "readonly", "Blob": "readonly",
    "URL": "readonly", "FileReader": "readonly", "btoa": "readonly", "atob": "readonly",
    "TextEncoder": "readonly", "TextDecoder": "readonly", "CompressionStream": "readonly",
    "DecompressionStream": "readonly", "MouseEvent": "readonly", "PointerEvent": "readonly",
    "KeyboardEvent": "readonly", "DragEvent": "readonly", "DataTransfer": "readonly",
    "Set": "readonly", "Map": "readonly", "getComputedStyle": "readonly", "indexedDB": "readonly"
  },
  "rules": {
    "no-var": "off",
    "no-unused-vars": ["warn", { "args": "none" }],
    "eqeqeq": "off",
    "no-console": "off",
    "no-undef": "error",
    "no-redeclare": "warn"
  }
}
